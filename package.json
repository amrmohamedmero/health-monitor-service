{
  "name": "@monitor/health-service",
  "version": "1.0.0",
  "description": "One-call health-check + alerting for Node apps: register checks, fill in a Teams/Slack/Discord webhook (and optionally an AI key), done.",
  "keywords": ["health-check", "monitoring", "alerting", "teams", "slack", "discord", "cron"],
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch examples/basic-server.ts",
    "build": "tsc",
    "start": "node dist/examples/basic-server.js",
    "typecheck": "tsc --noEmit",
    "report:once": "tsx examples/basic-server.ts --report",
    "check:once": "tsx examples/basic-server.ts --check"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}

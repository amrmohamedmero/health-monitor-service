# --- Notification target (pick ONE) ---
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# POWER_AUTOMATE_WEBHOOK_URL=https://prod-xx.eastus.logic.azure.com:443/workflows/...

# --- Auth for the HTTP cron endpoints ---
# Generate with: openssl rand -hex 32
CRON_SECRET=changeme

# --- Cosmetic / behavior ---
SERVICE_NAME=My Service
DASHBOARD_URL=https://example.com/admin/monitoring
TIMEZONE=Asia/Dubai
PORT=8080

# Gate: only run real checks when this is true, so staging/dev pings don't
# spam Teams. Set NODE_ENV=production in your real deployment.
NODE_ENV=development

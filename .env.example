# --- Notification targets (set as many as you want — every one that's
# --- present gets a message; you're not limited to one destination) ---
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# POWER_AUTOMATE_WEBHOOK_URL=https://prod-xx.eastus.logic.azure.com:443/workflows/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx

# --- Auth for the HTTP cron endpoints ---
# Generate with: openssl rand -hex 32
CRON_SECRET=changeme

# --- Optional: AI analysis attached to alerts (see src/analysis.ts) ---
# Omit ANTHROPIC_API_KEY entirely to leave this feature off.
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYSIS_MODEL=claude-sonnet-5

# --- Cosmetic / behavior ---
SERVICE_NAME=My Service
DASHBOARD_URL=https://example.com/admin/monitoring
TIMEZONE=Asia/Dubai
PORT=8080

# Gate: only run real checks when this is true, so staging/dev pings don't
# spam your channels. Set NODE_ENV=production in your real deployment.
NODE_ENV=development
